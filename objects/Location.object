    <fields>
        <fullName>Total_Value__c</fullName>
        <description>Conga</description>
        <formula>BLANKVALUE(Personal_Property_Value__c, 0)  +  BLANKVALUE(Real_Property_Value__c, 0)  +  BLANKVALUE(Building_Improvement__c, 0)  +  BLANKVALUE(Inventory_Value__c, 0)  +  BLANKVALUE(Business_Interruption_Value__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Insured Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Under_Construction__c</fullName>
        <formula>IF(

AND(
NOT(ISNULL( ConstructionStartDate )),
ConstructionStartDate&lt;=TODAY(),
 OR(ConstructionEndDate &gt;TODAY(),ISNULL(ConstructionEndDate))),

TRUE,
FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Under Construction?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
