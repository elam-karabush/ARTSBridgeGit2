        <externalId>false</externalId>
        <formula>/*
Total_Visits_QVOL_Q1__c +
Total_Visits_QVOL_Q2__c +
Total_Visits_QVOL_Q3__c +
Total_Visits_QVOL_Q4__c
*/
IF(
And(Total_Visits_QVOL_Q1__c &gt;= 0,
Total_Visits_QVOL_Q2__c &gt;= 0,
Total_Visits_QVOL_Q3__c &gt;= 0,
Total_Visits_QVOL_Q4__c &gt;= 0),
Total_Visits_QVOL_Q1__c +
Total_Visits_QVOL_Q2__c +
Total_Visits_QVOL_Q3__c +
Total_Visits_QVOL_Q4__c,
IF(
And(Total_Visits_QVOL_Q1__c &gt;= 0,
Total_Visits_QVOL_Q2__c &gt;= 0,
Total_Visits_QVOL_Q3__c &gt;= 0),
Total_Visits_QVOL_Q1__c +
Total_Visits_QVOL_Q2__c +
Total_Visits_QVOL_Q3__c,
IF(
And(Total_Visits_QVOL_Q1__c &gt;= 0,
Total_Visits_QVOL_Q2__c &gt;= 0),
Total_Visits_QVOL_Q1__c +
Total_Visits_QVOL_Q2__c, Total_Visits_QVOL_Q1__c
)))</formula>
        <inlineHelpText>Total Visits QVOL YTD</inlineHelpText>
        <label>Total Visits QVOL YTD Formula</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
