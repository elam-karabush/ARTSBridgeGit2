    <fields>
        <fullName>Previous_Quarter_c__c</fullName>
        <description>This provides a merge field used by Conga for the Quarterly Insurance Carrier update.</description>
        <externalId>false</externalId>
        <formula>CASE( MONTH( ( TODAY() ) ),
4, &apos;Q1 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
5, &apos;Q1 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
6, &apos;Q1 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
7, &apos;Q2 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
8, &apos;Q2 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
9, &apos;Q2 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
10,&apos;Q3 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
11,&apos;Q3 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
12,&apos;Q3 - &apos;&amp; TEXT(YEAR(( TODAY() ))),
1,&apos;Q4 - &apos;&amp; TEXT(YEAR(( TODAY() ))-1),
2,&apos;Q4 - &apos;&amp; TEXT(YEAR(( TODAY() ))-1),
3,&apos;Q4 - &apos;&amp; TEXT(YEAR(( TODAY() ))-1),
&apos;0&apos;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Indicates prior quarter from today for the Insurance Carrier merge output.</inlineHelpText>
        <label>Previous Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
