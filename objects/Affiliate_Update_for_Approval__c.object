    <fields>
        <fullName>External_Stage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL( Stage__c ,&quot;Needs Review&quot;),&quot;Pending Review&quot;,IF(
ISPICKVAL( Stage__c ,&quot;Approved&quot;),&quot;Approved&quot;,&quot;Rejected&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>External Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Fiscal_Quarter__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(YEAR(DATEVALUE(CreatedDate))) &amp;



(if( MONTH(DATEVALUE(CreatedDate)) &lt;4,&quot;Q1&quot;,

if( MONTH(DATEVALUE(CreatedDate)) &lt;7,&quot;Q2&quot;,

if( MONTH(DATEVALUE(CreatedDate)) &lt;10,&quot;Q3&quot;,

&quot;Q4&quot;

))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Fiscal Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
