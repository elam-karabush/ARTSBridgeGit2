<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>50.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>File Uploader</masterLabel>
    <description>Uploads a file to a record.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="label" type="String" label="Label" description="Label displayed on the component."/>
            <property name="fileTypes" type="String" label="Accepted File Types" description="Accepted file types for the uploader, separated by commas." placeholder=".pdf,.jpg,.png"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>